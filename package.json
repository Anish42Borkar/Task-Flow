{
  "name": "taskflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TaskFlow - Full-Stack Task Management Application",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "backend": "npm run start:dev --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend"
  },
  "keywords": [
    "taskflow",
    "react",
    "nestjs",
    "postgresql",
    "drizzle-orm",
    "socketio"
  ],
  "author": "TaskFlow Team",
  "license": "MIT",
  "dependencies": {
    "drizzle-orm": "^0.45.4"
  }
}
